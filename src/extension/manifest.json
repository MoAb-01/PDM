{
  "manifest_version": 3,
  "name": "AB Download Manager Companion",
  "version": "1.0.0",
  "description": "Companion media sniffer & download interception extension for AB Download Manager. Sniffs HLS .m3u8, MPEG-DASH .mpd, video/audio chunks, and direct file streams.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8989/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AB Media Sniffer"
  }
}
